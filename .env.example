# Copy to .env.local and replace both placeholders using your Supabase project settings.
# These NEXT_PUBLIC values are visible in the browser. Never use a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
